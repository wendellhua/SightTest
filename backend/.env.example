# ===== 应用 =====
APP_NAME=SightTest
DEBUG=false

# ===== 数据库（async 给 FastAPI，sync 给 Alembic/Celery） =====
DATABASE_URL=postgresql+asyncpg://sighttest:sighttest@localhost:5432/sighttest
DATABASE_URL_SYNC=postgresql+psycopg://sighttest:sighttest@localhost:5432/sighttest

# ===== Redis（0=缓存/锁，1=broker，2=result） =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== JWT（生产务必更换，至少 32 位随机串） =====
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== 敏感信息加密（Fernet key，base64 32 字节） =====
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ===== MinIO 对象存储 =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sighttest
MINIO_SECURE=false

# ===== SMTP 邮件（注册 / 找回密码验证码，必须配置，否则发送验证码接口返回 503） =====
# 方式一：真实邮箱服务（验证码会投递到用户真实邮箱）
#   QQ 邮箱：SMTP_HOST=smtp.qq.com    SMTP_PORT=465  SMTP_USER=xxx@qq.com    SMTP_PASSWORD=<授权码>
#   163 邮箱：SMTP_HOST=smtp.163.com  SMTP_PORT=465  SMTP_USER=xxx@163.com   SMTP_PASSWORD=<授权码>
#   Gmail：  SMTP_HOST=smtp.gmail.com SMTP_PORT=587  SMTP_USER=xxx@gmail.com SMTP_PASSWORD=<应用专用密码>
#   465 端口自动使用隐式 TLS；587 端口使用 STARTTLS。SMTP_FROM 需与 SMTP_USER 一致，否则多数服务商会拒信。
# 方式二：本地 MailPit（仅开发调试，邮件被本地拦截，不会投递到真实邮箱）
#   启动 deploy/docker-compose.yml 中的 mailpit 后配置：
#   SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_START_TLS=false  SMTP_FROM=noreply@sighttest.dev
#   邮件在 MailPit Web UI（http://localhost:8025）查看
SMTP_HOST=
SMTP_PORT=587
SMTP_START_TLS=true
SMTP_USE_TLS=false
SMTP_TIMEOUT=15
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===== 内置管理员（首次启动自动创建，建议首次登录后修改密码） =====
ADMIN_EMAIL=admin@st.com
ADMIN_PASSWORD=admin123
